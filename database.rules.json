{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": false
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        ".validate": "newData.hasChildren(['displayName', 'email', 'createdAt']) && (root.child('admins').child(auth.uid).exists() || newData.child('role').val() === data.child('role').val() || (!data.exists() && newData.child('role').val() === 'user'))"
      }
    },
    "hostRegistrations": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "$registrationId": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (auth.uid === $uid && newData.child('userId').val() === auth.uid && newData.child('status').val() === 'pending'))",
          ".validate": "newData.hasChildren(['userId', 'fullName', 'email', 'phone', 'address', 'city', 'state', 'pincode', 'outletType', 'chargingSpeed', 'availableHours', 'pricePerHour', 'agreeToTerms', 'status']) && newData.child('userId').val() === $uid && newData.child('agreeToTerms').val() === true && (newData.child('status').val() === 'pending' || root.child('admins').child(auth.uid).exists())"
        }
      }
    },
    "chargingSpots": {
      ".read": true,
      ".indexOn": ["hostId", "status", "city", "isVerified"],
      "$spotId": {
        ".read": true,
        ".write": "auth != null && (root.child('admins').child(auth.uid).exists() || (data.exists() && data.child('hostId').val() === auth.uid && newData.child('hostId').val() === data.child('hostId').val()) || (!data.exists() && newData.child('hostId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['hostId', 'hostName', 'address', 'city', 'state', 'pincode', 'outletType', 'pricePerHour']) && (!newData.child('hostId').exists() || newData.child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).exists())"
      }
    },
    "networkStations": {
      ".read": true,
      "$stationId": {
        ".read": true,
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['stationName', 'networkOperator', 'address', 'city', 'state', 'pincode', 'coordinates']) && newData.child('coordinates').hasChildren(['lat', 'lng']) && newData.child('coordinates').child('lat').isNumber() && newData.child('coordinates').child('lat').val() >= -90 && newData.child('coordinates').child('lat').val() <= 90 && newData.child('coordinates').child('lng').isNumber() && newData.child('coordinates').child('lng').val() >= -180 && newData.child('coordinates').child('lng').val() <= 180"
      }
    },
    "spotRequests": {
      "$spotId": {
        ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('chargingSpots').child($spotId).child('hostId').val() === auth.uid)",
        "$requestId": {
          ".read": "auth != null && (root.child('admins').child(auth.uid).exists() || root.child('chargingSpots').child($spotId).child('hostId').val() === auth.uid || data.child('userId').val() === auth.uid)",
          ".write": "auth != null && ((auth.uid === newData.child('userId').val() && newData.child('spotId').val() === $spotId && !data.exists()) || (data.exists() && root.child('chargingSpots').child($spotId).child('hostId').val() === auth.uid) || root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.child('userId').val() === auth.uid && newData.child('spotId').val() === $spotId"
        }
      }
    },
    "spotReviews": {
      "$spotId": {
        ".read": "auth != null",
        "$reviewId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === newData.child('userId').val()",
          ".validate": "auth.uid === newData.child('userId').val() && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5"
        }
      }
    },
    "availability": {
      "$uid": {
        ".read": true,
        "$spotId": {
          ".read": true,
          ".write": "auth != null && auth.uid === $uid",
          "$date": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['date', 'open', 'close', 'blocked'])"
          }
        }
      }
    },
    "bookingChat": {
      "$threadId": {
        ".read": "auth != null && (root.child('bookingChat').child($threadId).child('riderId').val() === auth.uid || root.child('bookingChat').child($threadId).child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && auth.uid === newData.child('riderId').val() && !data.exists()",
        ".validate": "newData.hasChildren(['spotId', 'riderId']) || newData.hasChildren(['riderId'])",
        "messages": {
          "$messageId": {
            ".read": "auth != null && (root.child('bookingChat').child($threadId).child('riderId').val() === auth.uid || root.child('bookingChat').child($threadId).child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
            ".write": "auth != null && auth.uid === newData.child('senderId').val()",
            ".validate": "newData.hasChildren(['threadId', 'senderId', 'text', 'createdAt']) && newData.child('threadId').val() === $threadId"
          }
        }
      }
    },
    "payoutRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$requestId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid && (!data.exists() || data.child('status').val() === 'paid' || data.child('status').val() === 'rejected')",
          ".validate": "newData.hasChildren(['amount', 'status', 'requestedAt', 'createdAt']) && newData.child('status').val() === 'pending'"
        }
      }
    },
    "payouts": {
      "$hostId": {
        ".read": "auth != null && (auth.uid === $hostId || root.child('admins').child(auth.uid).exists())",
        "$payoutId": {
          ".read": "auth != null && (auth.uid === $hostId || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['hostId', 'amount', 'status'])"
        }
      }
    },
    "hostVerifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$caseId": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.child('uid').val() === $uid && newData.child('uid').val() === auth.uid"
        }
      }
    },
    "hostVerificationsIndex": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$caseId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['uid', 'status', 'documents']) && newData.child('uid').val() === data.child('uid').val()"
      }
    },
    "spotListingReviews": {
      "$spotId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".validate": "newData.hasChildren(['spotId', 'hostId', 'status', 'submittedAt']) && newData.child('spotId').val() === $spotId"
      }
    },
    "chargingRequests": {
      ".indexOn": ["spotId", "status", "userId"],
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
        "$requestId": {
          ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.child('userId').val() === $uid"
        }
      }
    },
    "spotWaitlist": {
      "$spotId": {
        ".read": true,
        "$waitId": {
          ".read": true,
          ".write": "auth != null && (root.child('chargingSpots').child($spotId).child('hostId').val() === auth.uid || root.child('admins').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['userId', 'joinedAt']) && newData.child('userId').val() === auth.uid"
        }
      }
    },
    "spotLiveStatus": {
      "$spotId": {
        ".read": true,
        "$hostId": {
          ".read": true,
          ".write": "auth != null && (auth.uid === $hostId || root.child('admins').child(auth.uid).exists())"
        }
      }
    },
    "hostSettings": {
      ".indexOn": ["listingPaused"],
      "$hostId": {
        ".read": true,
        ".write": "auth != null && (auth.uid === $hostId || root.child('admins').child(auth.uid).exists())"
      }
    },
    "referralCodes": {
      "$hostId": {
        ".read": "auth != null && (auth.uid === $hostId || root.child('admins').child(auth.uid).exists())",
        ".write": "auth != null && root.child('admins').child(auth.uid).exists()"
      }
    },
    "referralClaims": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      ".write": false
    },
    "riderRatings": {
      "$riderId": {
        ".read": "auth != null",
        "$ratingId": {
          ".read": "auth != null",
          ".write": "auth != null && auth.uid === newData.child('hostId').val() && !data.exists()",
          ".validate": "newData.hasChildren(['hostId', 'rating', 'ratedAt']) && newData.child('rating').val() >= 1 && newData.child('rating').val() <= 5 && newData.child('hostId').val() === auth.uid"
        }
      }
    },
    "contentFlags": {
      ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
      "$flagId": {
        ".read": "auth != null && root.child('admins').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('reporterId').val() === auth.uid && newData.hasChildren(['targetType', 'targetId', 'reason', 'reporterId', 'reporterName', 'status', 'createdAt']) && newData.child('status').val() === 'open' && (newData.child('targetType').val() === 'review' || newData.child('targetType').val() === 'user')) || (data.exists() && data.child('status').val() === 'open' && root.child('admins').child(auth.uid).exists() && newData.child('status').val() === 'resolved'))",
        ".validate": "newData.hasChildren(['targetType', 'targetId', 'reason', 'reporterId', 'status'])"
      }
    }
  }
}
